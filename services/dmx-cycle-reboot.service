[Unit]
Description=Run DMX script with Conda environment
After=network.target

[Service]
Type=simple
User=laser-dmx
WorkingDirectory=/home/laser-dmx/fiber-laser-dmx/scripts
ExecStart=/home/laser-dmx/miniconda3/envs/fiber-laser/bin/python /home/laser-dmx/fiber-laser-dmx/scripts/dmx_cycle_reboot.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
